{
  "name": "skyjoust-party",
  "version": "1.0.0",
  "description": "Phones-as-controllers party joust game with music-driven mechanics, real-time WebSocket relay.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "tunnel": "concurrently --names \"SERVER,TUNNEL\" --prefix-colors \"cyan,yellow\" \"node server.js\" \"cloudflared tunnel --url http://localhost:3000\"",
    "test": "node test/echo-test.js && node test/integration-test.js",
    "predeploy": "echo Deploying public/ to gh-pages...",
    "deploy": "gh-pages -d public -b gh-pages"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.4",
    "gh-pages": "^6.3.0"
  }
}
